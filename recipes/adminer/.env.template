# Adminer is stateless and requires no secrets of its own.
# Access is controlled by the Traefik basic-auth gate declared in metadata.yaml
# (basic_auth: true) — the customer's server password is applied there, not here.
#
# Optional Adminer environment variables (uncomment to enable):
# ADMINER_PLUGINS=tables-filter tinymce   # space-separated plugin names
# ADMINER_DESIGN=pepa-linha               # bundled design theme
# ADMINER_DEFAULT_SERVER=db.example.com  # pre-fill the Server field on login
