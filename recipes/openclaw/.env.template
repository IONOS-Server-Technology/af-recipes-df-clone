# Generated per VM by install.sh on first boot: the gateway refuses to start without it,
# and a literal committed here would be the same token on every customer VM.
OPENCLAW_GATEWAY_TOKEN=

# Provider credentials belong to the customer — nobody else can supply them, and nothing
# substitutes values into this file (IF-944). They ship empty and stay empty until the
# customer fills them in here and restarts the app; the Compose file defaults each one to
# empty, so the gateway starts fine without any of them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TZ=UTC
