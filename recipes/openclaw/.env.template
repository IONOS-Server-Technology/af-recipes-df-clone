# Generated for this server during installation: the gateway refuses to start without it,
# and a fixed value would be the same token on every server.
OPENCLAW_GATEWAY_TOKEN=

# Provider credentials are yours — nobody else can supply them. They are empty and stay
# empty until you fill them in here and restart the app. Each one defaults to empty, so
# the gateway starts fine without any of them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TZ=UTC
