# The initial Django superuser. The name is a fixed convention, matching the other
# recipes with a single conventional admin account; the password is generated per VM by
# install.sh and read back out of this file.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Generated per VM by install.sh on first boot. Empty because nothing substitutes values
# into this file (IF-944) — a literal SECRET_KEY here would let anyone with repo access
# forge sessions on every customer VM, and one shared database password is no better.
DB_PASSWORD=
SECRET_KEY=
REDIS_PASSWORD=
