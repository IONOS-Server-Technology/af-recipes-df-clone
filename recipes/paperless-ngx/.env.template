# The initial Django superuser. The name is a fixed convention, matching the other
# applications with a single admin account; the password is generated for this server
# during installation and read back out of this file.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Generated for this server during installation. Empty in the delivered file — a fixed
# SECRET_KEY would let anyone who knows it forge sessions on every server, and a shared
# database password is no better.
DB_PASSWORD=
SECRET_KEY=
REDIS_PASSWORD=
