BASE_DOMAIN={{BASE_DOMAIN}}
WUD_ADMIN_PASSWORD={{WUD_ADMIN_PASSWORD}}

# --- Notification triggers (uncomment and configure to enable) ---
# ntfy push notifications — free public server or self-hosted
# WUD_TRIGGER_NTFY_NOTIFY_TOPIC=your-unique-topic-name
# WUD_TRIGGER_NTFY_NOTIFY_URL=https://ntfy.sh
# WUD_TRIGGER_NTFY_NOTIFY_PRIORITY=3
# WUD_TRIGGER_NTFY_NOTIFY_AUTO=true
# WUD_TRIGGER_NTFY_NOTIFY_THRESHOLD=all

# SMTP email notifications
# WUD_TRIGGER_SMTP_EMAIL_HOST=smtp.example.com
# WUD_TRIGGER_SMTP_EMAIL_PORT=587
# WUD_TRIGGER_SMTP_EMAIL_USER=user@example.com
# WUD_TRIGGER_SMTP_EMAIL_PASS=yourpassword
# WUD_TRIGGER_SMTP_EMAIL_FROM=wud@example.com
# WUD_TRIGGER_SMTP_EMAIL_TO=admin@example.com
# WUD_TRIGGER_SMTP_EMAIL_AUTO=true
# WUD_TRIGGER_SMTP_EMAIL_THRESHOLD=all
