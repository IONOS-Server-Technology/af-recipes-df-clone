# The Pi-hole admin web password, generated for this server during installation and read
# back out of this file. Empty in the delivered file, so no two servers share an admin
# password.
WEBPASSWORD=

# The WireGuard interface address Pi-hole listens on. A fixed value, not a secret; the
# Compose file defaults to the same address if this line is absent.
WG_INTERFACE_IP=10.8.0.1
