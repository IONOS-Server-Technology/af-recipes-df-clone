# The Pi-hole admin web password, generated per VM by install.sh on first boot and read
# back out of this file. Empty because nothing substitutes values into it (IF-944) — the
# placeholder this used to carry gave every customer the same admin password.
WEBPASSWORD=

# The WireGuard interface address Pi-hole listens on. A fixed value, not a secret; the
# Compose file defaults to the same address if this line is absent.
WG_INTERFACE_IP=10.8.0.1
