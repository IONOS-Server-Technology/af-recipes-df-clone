# OPENROUTER_API_KEY and TELEGRAM_BOT_TOKEN ship empty on purpose: af-core no
# longer substitutes {{PLACEHOLDER}} values into this file (removed with
# IF-944 — see IF-1309 review), so a placeholder here would arrive on the VM
# as literal text, not a real value. install.sh's non-empty check on
# OPENROUTER_API_KEY depends on that being genuinely empty until the customer
# sets it via the authenticated dashboard post-provision.
OPENROUTER_API_KEY=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD={{HERMES_DASHBOARD_BASIC_AUTH_PASSWORD}}
HERMES_DASHBOARD_BASIC_AUTH_SECRET={{HERMES_DASHBOARD_BASIC_AUTH_SECRET}}
TELEGRAM_BOT_TOKEN=
TZ=UTC
