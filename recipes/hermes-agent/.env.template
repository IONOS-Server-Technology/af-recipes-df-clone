# OPENROUTER_API_KEY and TELEGRAM_BOT_TOKEN ship empty on purpose: af-core no
# longer substitutes double-curly-brace placeholder values into this file
# (removed with IF-944 — see IF-1309 review), so a placeholder here would
# arrive on the VM as literal text, not a real value. install.sh's non-empty
# check on OPENROUTER_API_KEY depends on that being genuinely empty until the
# customer sets it via the authenticated dashboard post-provision.
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=

# Dashboard login. The username is fixed to "admin" in docker-compose.yaml; the
# password below is generated per VM by install.sh on first boot, so read it from
# this file (/opt/hermes-agent/.env) to log in. Change it by editing this line and
# restarting the app — install.sh keeps any non-empty value it finds here.
#
# The container refuses to start on a non-loopback bind without a password, so this
# cannot be left empty. It used to carry a placeholder, which meant every customer's
# dashboard had the same password, readable from this repo. Interim solution: IF-1437
# decides whether this frontend moves behind Traefik basic-auth (IF-1312) or IF-1420
# grows a plaintext mode — a projection of the customer's own server password would
# save them having to look this up at all.
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
TZ=UTC
