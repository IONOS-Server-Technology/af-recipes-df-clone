# OPENROUTER_API_KEY and TELEGRAM_BOT_TOKEN ship empty on purpose: af-core no
# longer substitutes double-curly-brace placeholder values into this file
# (removed with IF-944 — see IF-1309 review), so a placeholder here would
# arrive on the VM as literal text, not a real value. install.sh's non-empty
# check on OPENROUTER_API_KEY depends on that being genuinely empty until the
# customer sets it via the authenticated dashboard post-provision.
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=

# Dashboard login: username "admin", and your own server password — nothing to look up
# here any more. The line below is not the password: af-api derives an scrypt hash of the
# server password at order time and the renderer writes it in (IF-1454), so the plaintext
# never reaches this VM. It ships empty because nothing substitutes into this file (IF-944);
# the renderer fills it, and the dollars are doubled on the way in because Compose would
# otherwise eat them.
#
# To set a different dashboard password, replace the value with a hash produced by the
# app itself:
#   docker exec hermes-agent-hermes-agent-1 python3 -c \
#     "import sys; sys.path.insert(0,'/opt/hermes'); \
#      from plugins.dashboard_auth.basic import hash_password; print(hash_password('new-pw'))"
# then double every dollar in the result and restart the app. The container refuses to
# start on a non-loopback bind without a password, so this must not be left empty.
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=

# Signs dashboard session cookies. Generated per VM by install.sh on first boot and kept
# across re-runs, so logged-in sessions survive. Not something the customer ever types.
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
TZ=UTC
