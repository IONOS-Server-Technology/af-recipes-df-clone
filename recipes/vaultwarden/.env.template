# Empty until IF-1420 fills it: af-api derives the /admin token from the customer's server
# password at compose time and the renderer writes the argon2 hash in here. Empty is the
# right default in the meantime. Vaultwarden treats an empty value as "off" and says so on
# startup: "ADMIN_TOKEN is enabled but has an empty value, so the admin page will be
# disabled." The literal placeholder this used to carry did the opposite — it opened the
# panel with a token readable from this repo.
ADMIN_TOKEN=

# Signups must stay on for the initial account: with /admin disabled (above), this is the
# only way the customer gets into their own vault. Matches the documented default in
# metadata.yaml. Anyone who finds the hostname can register until the customer turns this
# off, which is the standard self-hosted Vaultwarden day-2 step — so it is worth revisiting
# once this frontend can sit behind Traefik basic-auth (IF-1312).
SIGNUPS_ALLOWED=true
