# Filled in automatically with a hash of your server password, so there is nothing to look
# up: open /admin and sign in with the password you already have. While it is empty,
# Vaultwarden treats the admin page as switched off and says so on startup:
# "ADMIN_TOKEN is enabled but has an empty value, so the admin page will be disabled."
ADMIN_TOKEN=

# Signups must stay on for the initial account: with /admin disabled (above), this is the
# only way you get into your own vault. Anyone who finds the hostname can register until
# you turn this off, which is the standard step after creating your account.
SIGNUPS_ALLOWED=true
