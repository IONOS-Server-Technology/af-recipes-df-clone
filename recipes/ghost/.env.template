# Secrets are generated for this server during installation and written back here.
# They are empty in the delivered file, so no two servers share a secret.
DATABASE_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Pin a specific Ghost image tag (e.g. 6.56.0-alpine) to lock the version.
# Leave empty to use the floating 6-alpine tag defined in docker-compose.yaml.
GHOST_VERSION=
