# Default application-level credentials for the Traggo admin account.
# These values are identical on every install. The real security gate is the
# Traefik basic-auth layer (metadata.yaml: basic_auth: true on port 3030).
# Traggo hashes these in-process at startup, so a pre-hashed value cannot be
# supplied here — change them after first login if you want per-site credentials.
TRAGGO_DEFAULT_USER_NAME=admin
TRAGGO_DEFAULT_USER_PASS=admin
