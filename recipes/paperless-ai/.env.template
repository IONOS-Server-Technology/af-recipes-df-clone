# The Paperless-ngx instance this connects to, and the token to reach it. Both are yours —
# nobody else knows your Paperless URL. They ship empty; fill them in here and restart
# the app.
PAPERLESS_URL=
PAPERLESS_API_TOKEN=

# Which LLM provider to use, and its key. The provider is a plain default; the key is the
# customer's own. The Compose file defaults both to the same, so an empty key just means
# the AI features stay off until one is supplied.
AI_PROVIDER=openai
OPENAI_API_KEY=
