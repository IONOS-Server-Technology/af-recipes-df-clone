# The Paperless-ngx instance this connects to, and the token to reach it. Both belong to
# the customer — nobody else knows their Paperless URL — and nothing substitutes values
# into this file (IF-944). They ship empty; the customer fills them in here and restarts.
PAPERLESS_URL=
PAPERLESS_API_TOKEN=

# Which LLM provider to use, and its key. The provider is a plain default; the key is the
# customer's own. The Compose file defaults both to the same, so an empty key just means
# the AI features stay off until one is supplied.
AI_PROVIDER=openai
OPENAI_API_KEY=
