# Pgweb is stateless and requires no secrets of its own.
# Access is controlled by the Traefik basic-auth gate declared in metadata.yaml
# (basic_auth: true) — the customer's server password is applied there, not here.
#
# Optional: pre-connect to a specific Postgres instance on startup.
# Leave unset to let the user supply the connection via the web UI instead.
# PGWEB_DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable
