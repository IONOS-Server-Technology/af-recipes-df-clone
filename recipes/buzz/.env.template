# Database password — generated for this server during installation.
# Empty in the delivered file so no two servers share the same credential.
POSTGRES_PASSWORD=

# Redis authentication password — generated during installation.
REDIS_PASSWORD=

# MinIO/S3 access key for media storage — generated during installation.
BUZZ_S3_ACCESS_KEY=

# MinIO/S3 secret key for media storage — generated during installation.
BUZZ_S3_SECRET_KEY=

# Nostr private key (64-char hex) that identifies this relay — generated once
# and must remain stable across restarts.
BUZZ_RELAY_PRIVATE_KEY=

# HMAC signing key for git webhook events — generated during installation.
BUZZ_GIT_HOOK_HMAC_SECRET=
