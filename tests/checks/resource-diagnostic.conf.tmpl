# ---- post-install diagnostics: informational, never fails the run ----

[test_resource_usage]
class = Plugins.Ssh.Test
executors = exec_vm
comment = Record actual RAM, disk and per-container memory for this selection
cmd = (echo "--- free -m ---"; free -m; echo "--- df -h / ---"; df -h /; echo "--- docker stats ---"; docker stats --no-stream --format '{{.Name}}\t{{.MemUsage}}\t{{.CPUPerc}}') 2>&1 || true
expected_exitcode = 0
