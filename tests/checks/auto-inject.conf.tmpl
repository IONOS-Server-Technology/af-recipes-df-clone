# Auto-inject recipes (wud today) are injected once per VM, not once per app, so
# this include stays a single block however many apps are in the selection.
# It is deliberately NOT the last section: the two AF Logs blocks below have to
# run after every other test, because they collect the evidence for the ones that
# failed. Test cases execute in the order they are loaded.
[include_auto_inject]
path = auto-inject
