#!/usr/bin/env python3
"""Generate LOGO.md — a grid overview of every recipe's logo, from
recipes/*/metadata.yaml and recipes/*/logo.svg. Regenerated automatically
by .github/workflows/regenerate-logo-overview.yaml on every push that
touches a recipe's logo or metadata — this script only needs a manual run
for local preview."""
import subprocess
import sys
from pathlib import Path

import yaml

COLUMNS = 4


def logo_datetime(repo_root, logo_path):
    """Last-commit timestamp (ISO 8601, e.g. 2026-08-22T09:14:33+00:00) for
    logo_path, or None if it has no git history yet (uncommitted, or run
    outside a full clone). Full timestamp, not just the date, so multiple
    logos landing the same day still sort newest-first by actual commit
    time rather than falling back to alphabetical order."""
    result = subprocess.run(
        ["git", "log", "-1", "--format=%aI", "--", str(logo_path)],
        cwd=repo_root, capture_output=True, text=True,
    )
    dt = result.stdout.strip()
    return dt or None


def main():
    repo_root = Path(__file__).resolve().parent.parent
    recipes_dir = repo_root / "recipes"
    output_file = repo_root / "LOGO.md"

    if not recipes_dir.is_dir():
        print(f"Error: {recipes_dir} not found", file=sys.stderr)
        sys.exit(1)

    entries = []
    missing_logo = []
    for recipe_dir in sorted(recipes_dir.iterdir()):
        if not recipe_dir.is_dir():
            continue
        slug = recipe_dir.name
        metadata_file = recipe_dir / "metadata.yaml"
        if not metadata_file.is_file():
            continue
        with open(metadata_file, encoding="utf-8") as f:
            metadata = yaml.safe_load(f)
        display_name = metadata.get("display_name", slug)
        logo_path = recipe_dir / "logo.svg"
        logo_rel = f"recipes/{slug}/logo.svg"
        if not logo_path.is_file():
            missing_logo.append(display_name)
            continue
        img = f'<img src="{logo_rel}" width="56" height="56" alt="{display_name}">'
        commit_dt = logo_datetime(repo_root, logo_path)
        date = commit_dt[:10] if commit_dt else None
        # Undated (uncommitted/untracked) logos sort first — newest-first,
        # and "not committed yet" is newer than anything with a real
        # timestamp. Sorting on the full ISO datetime (not just the date)
        # keeps same-day logos in actual commit order instead of falling
        # back to alphabetical.
        entries.append({"sort_key": commit_dt or "9999-99-99T99:99:99+00:00",
                        "display_name": display_name, "img": img, "date": date})

    entries.sort(key=lambda e: e["sort_key"], reverse=True)

    cards = []
    for e in entries:
        date_line = f'<sub>{e["date"]}</sub>' if e["date"] else '<sub>&nbsp;</sub>'
        cards.append(
            f'<td align="center" width="{100 // COLUMNS}%">\n'
            f'{e["img"]}<br>\n'
            f'<sub><b>{e["display_name"]}</b></sub><br>\n'
            f'{date_line}\n'
            f'</td>'
        )

    rows = []
    for i in range(0, len(cards), COLUMNS):
        row_cards = cards[i:i + COLUMNS]
        while len(row_cards) < COLUMNS:
            row_cards.append("<td></td>")  # pad the last row so columns stay even width
        rows.append("<tr>\n" + "\n".join(row_cards) + "\n</tr>")

    table = '<table width="100%">\n' + "\n".join(rows) + "\n</table>"

    lines = [
        "# Recipe logo overview",
        "",
        f"{len(cards)} recipes with a logo, sorted by logo date (newest first). "
        "Auto-regenerated by `.github/workflows/regenerate-logo-overview.yaml` "
        "on every push that changes a recipe's logo or metadata — don't "
        "hand-edit this file.",
        "",
    ]
    if missing_logo:
        lines.append(f"**{len(missing_logo)} recipe(s) without a `logo.svg` yet:**")
        lines.append("")
        lines.extend(f"- {name}" for name in sorted(missing_logo))
        lines.append("")
    lines.append(table)
    lines.append("")

    output_file.write_text("\n".join(lines), encoding="utf-8")
    print(f"Wrote {output_file} ({len(cards)} recipes, {len(missing_logo)} missing logo.svg)")


if __name__ == "__main__":
    main()
