#!/usr/bin/env python3
"""Build catalogue.json from all recipes/*/metadata.yaml files."""
import json
import sys
from pathlib import Path

import yaml


def main():
    repo_root = Path(__file__).resolve().parent.parent
    recipes_dir = repo_root / "recipes"
    baselines_file = repo_root / "os-baselines.yaml"
    output_file = repo_root / "catalogue.json"

    if not recipes_dir.is_dir():
        print(f"Error: {recipes_dir} not found", file=sys.stderr)
        sys.exit(1)

    # Load OS baselines
    if not baselines_file.is_file():
        print(f"Error: {baselines_file} not found", file=sys.stderr)
        sys.exit(1)

    with open(baselines_file) as f:
        os_baselines = yaml.safe_load(f).get("baselines", {})

    print(f"Loaded OS baselines: {', '.join(os_baselines.keys())}")

    recipes = []
    errors = []

    for metadata_path in sorted(recipes_dir.glob("*/metadata.yaml")):
        recipe_name = metadata_path.parent.name
        try:
            with open(metadata_path) as f:
                meta = yaml.safe_load(f)

            # Validate required fields
            required = [
                "name", "display_name", "description", "category",
                "app_version", "recipe_version", "recipe_type",
                "app_min_ram_mb", "app_min_disk_mb",
            ]
            missing = [field for field in required if field not in meta]
            if missing:
                errors.append(f"{recipe_name}: missing fields: {', '.join(missing)}")
                continue

            if meta["name"] != recipe_name:
                errors.append(
                    f"{recipe_name}: name '{meta['name']}' does not match directory"
                )
                continue

            # Validate supported_os entries have matching baselines
            for os_name in meta.get("supported_os", []):
                if os_name not in os_baselines:
                    errors.append(
                        f"{recipe_name}: supported_os '{os_name}' has no entry in os-baselines.yaml"
                    )

            # Build catalogue entry
            entry = {
                "name": meta["name"],
                "display_name": meta["display_name"],
                "description": meta["description"],
                "category": meta["category"],
                "app_version": str(meta["app_version"]),
                "recipe_version": str(meta["recipe_version"]),
                "recipe_type": meta["recipe_type"],
                "app_min_ram_mb": meta["app_min_ram_mb"],
                "app_min_disk_mb": meta["app_min_disk_mb"],
                "ports": meta.get("ports", []),
                "parameters": [
                    p["name"] for p in meta.get("parameters", [])
                ],
            }
            recipes.append(entry)
            print(f"  OK: {recipe_name}")

        except Exception as e:
            errors.append(f"{recipe_name}: {e}")

    if errors:
        print("\nErrors:", file=sys.stderr)
        for err in errors:
            print(f"  FAIL: {err}", file=sys.stderr)
        sys.exit(1)

    catalogue = {
        "os_baselines": os_baselines,
        "recipe_count": len(recipes),
        "recipes": recipes,
    }

    with open(output_file, "w") as f:
        json.dump(catalogue, f, indent=2)
        f.write("\n")

    print(f"\nGenerated {output_file} with {len(recipes)} recipes.")


if __name__ == "__main__":
    main()
