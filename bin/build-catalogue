#!/usr/bin/env python3
"""Build catalogue.json from all recipes/*/metadata.yaml files."""
import json
import sys
from pathlib import Path

import yaml


def main():
    repo_root = Path(__file__).resolve().parent.parent
    recipes_dir = repo_root / "recipes"
    output_file = repo_root / "catalogue.json"

    if not recipes_dir.is_dir():
        print(f"Error: {recipes_dir} not found", file=sys.stderr)
        sys.exit(1)

    recipes = []
    errors = []

    for metadata_path in sorted(recipes_dir.glob("*/metadata.yaml")):
        recipe_name = metadata_path.parent.name
        try:
            with open(metadata_path) as f:
                meta = yaml.safe_load(f)

            # Validate required fields
            required = [
                "id", "enabled", "display_name", "description", "categories",
                "app_version", "recipe_version", "recipe_type",
                "app_min_ram_mb", "app_min_disk_mb",
            ]
            missing = [field for field in required if field not in meta]
            if missing:
                errors.append(f"{recipe_name}: missing fields: {', '.join(missing)}")
                continue

            # Validate short_description
            sd = meta.get("short_description")
            if not sd or not isinstance(sd, dict):
                errors.append(f"{recipe_name}: missing or invalid short_description (must be a language map)")
            elif "en" not in sd:
                errors.append(f"{recipe_name}: short_description missing required 'en' key")
            else:
                for lang, text in sd.items():
                    if len(text) > 160:
                        errors.append(f"{recipe_name}: short_description['{lang}'] exceeds 160 chars ({len(text)})")

            if meta["id"] != recipe_name:
                errors.append(
                    f"{recipe_name}: id '{meta['id']}' does not match directory"
                )
                continue

            # Build catalogue entry
            entry = {
                "id": meta["id"],
                "enabled": meta["enabled"],
                "docker_auto_inject": meta.get("docker_auto_inject", False),
                "display_name": meta["display_name"],
                "description": meta["description"],
                "short_description": meta.get("short_description", {}),
                "categories": meta["categories"],
                "app_version": str(meta["app_version"]),
                "recipe_version": str(meta["recipe_version"]),
                "recipe_type": meta["recipe_type"],
                "app_min_ram_mb": meta["app_min_ram_mb"],
                "app_min_disk_mb": meta["app_min_disk_mb"],
                "ports": meta.get("ports", []),
                "parameters": [
                    p["name"] for p in meta.get("parameters", [])
                ],
            }
            recipes.append(entry)
            print(f"  OK: {recipe_name}")

        except Exception as e:
            errors.append(f"{recipe_name}: {e}")

    if errors:
        print("\nErrors:", file=sys.stderr)
        for err in errors:
            print(f"  FAIL: {err}", file=sys.stderr)
        sys.exit(1)

    catalogue = {
        "recipe_count": len(recipes),
        "recipes": recipes,
    }

    with open(output_file, "w") as f:
        json.dump(catalogue, f, indent=2)
        f.write("\n")

    print(f"\nGenerated {output_file} with {len(recipes)} recipes.")


if __name__ == "__main__":
    main()
